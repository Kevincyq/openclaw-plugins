# PKB 知识库配置模板
# 复制此文件为 .env 并填入实际配置

# PKB 知识库 API
PKB_BASE_URL=https://api.miaoda.io
PKB_API_KEY=
PKB_USER_ID=

# Nextcloud 配置（用于同步文件）
NEXTCLOUD_BASE_URL=https://nextcloud.kmchat.cloud
NEXTCLOUD_USERNAME=
NEXTCLOUD_APP_PASSWORD=

# FileSaaS（与 PKB_API_KEY 不同：先上传字节到 FileSaaS，再带 file_key 调 PKB API）
# 若已在插件根目录 config.json 中填写 fileSaaS，可不重复写下列变量（api 会自动补全）。
# 亦可由 ~/.openclaw/openclaw.json 的 plugins.entries.pkb.config.fileSaaS 注入（支持 tenantId/uploadServer 别名）。
FILESAAS_APP_ID=tct-pkb-api
FILESAAS_APP_SECRET=
FILESAAS_TENANT=tct-pkb
FILESAAS_SERVER=
