#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/home/kevincyq/src/openclaw-plugins/plugins/openclaw-pkb/node_modules/.pnpm/openshell@0.1.0/node_modules/openshell/node_modules:/home/kevincyq/src/openclaw-plugins/plugins/openclaw-pkb/node_modules/.pnpm/openshell@0.1.0/node_modules:/home/kevincyq/src/openclaw-plugins/plugins/openclaw-pkb/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/home/kevincyq/src/openclaw-plugins/plugins/openclaw-pkb/node_modules/.pnpm/openshell@0.1.0/node_modules/openshell/node_modules:/home/kevincyq/src/openclaw-plugins/plugins/openclaw-pkb/node_modules/.pnpm/openshell@0.1.0/node_modules:/home/kevincyq/src/openclaw-plugins/plugins/openclaw-pkb/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../../../../../openshell@0.1.0/node_modules/openshell/bin/openshell.js" "$@"
else
  exec node  "$basedir/../../../../../openshell@0.1.0/node_modules/openshell/bin/openshell.js" "$@"
fi
